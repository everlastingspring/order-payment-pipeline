    {
      "name": "Cancel & Refund",
      "item": [
        {
          "name": "22. Cancel Order (completed order)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Uses {{order_id}} from happy path saga.",
                  "// Order must be in CONFIRMED status (final state after happy path).",
                  "// CONFIRMED orders ARE cancellable — triggers full wallet refund (4097 INR back).",
                  "// Only CANCELLED and FAILED orders are blocked from cancellation."
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Cancel accepted', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Status is CANCELLED', () => pm.expect(json.data.status).to.eql('CANCELLED'));",
                  "console.log('Order cancelled. previousStatus was CONFIRMED — wallet refund of 4097 INR in flight via order.cancelled event.');"
                ],
                "type": "text/javascript"
              }
            }
